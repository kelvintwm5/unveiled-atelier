# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Supabase — owner sign-in (Google, configured in the Supabase dashboard under
# Authentication → Providers, not here) and all of the app's data.
# Both values are from: Supabase dashboard → Project Settings → API
# The anon key is NOT a secret; it ships in the browser bundle. Access is
# controlled by the row level security policies in supabase/migrations/.
# Never put the service_role key here — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only, for the daily reminder message (api/send-reminders.ts). Set these
# in the Vercel environment variables. Never prefix them with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=   Supabase dashboard → Project Settings → API
# TELEGRAM_BOT_TOKEN=          from @BotFather on Telegram
# TELEGRAM_CHAT_ID=            Esther's chat with the bot
# CRON_SECRET=                 any long random string; Vercel sends it on cron calls
